# Copie para .env e preencha (o .env fica só no seu computador e não vai para o git).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = manda o aviso "fique atento" quando fecham 3 velas iguais; 0 = só o aviso de entrada
ALERT_PRE=1
# segundos antes do fim da vela em que o aviso de entrada é avaliado (a Ebinex bloqueia nos últimos ~5s)
ALERT_LEAD_SEC=7
